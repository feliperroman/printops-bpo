{
  "name": "printops-bpo",
  "version": "1.0.0",
  "description": "Smart 3D Manufacturing Triage & Quoting Engine (Tier 1 / Tier 2 BPO)",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && node scripts/compliance-check.js"
  },
  "keywords": [
    "3d-printing",
    "bpo",
    "triage",
    "quoting",
    "fastify",
    "redis",
    "gemini",
    "cloud"
  ],
  "author": "PrintOps BPO Team",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/sensible": "^5.5.0",
    "@google/generative-ai": "^0.24.0",
    "fastify": "^4.26.2",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
